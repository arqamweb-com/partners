# الملفات المرفوعة لا تُطلب من المتصفح مباشرة إطلاقًا —
# التنزيل يتم عبر /api/files/{id} بعد فحص الصلاحية.
Require all denied

# حتى لو تعطّل السطر أعلاه على استضافة قديمة: لا تنفّذ أي كود هنا
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
AddType text/plain .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .cgi .pl .py .sh
