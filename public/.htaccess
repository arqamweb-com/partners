# ---------------------------------------------------------------------------
# أرقام فلو — إعدادات أباتشي للنسخة المرفوعة
#
# هذا الملف يُنسخ مع محتويات dist/ إلى مجلد الموقع على الاستضافة.
# وظيفته الأساسية: توجيه كل المسارات إلى index.html لأن التطبيق SPA —
# بدونه، تحديث الصفحة على /dashboard يعطي 404 من أباتشي.
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # لا تلمس طلبات الـ API — لها .htaccess خاص بها داخل /api
    RewriteRule ^api/ - [L]

    # الملفات والمجلدات الموجودة فعلًا تُقدَّم كما هي
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # أي مسار آخر يذهب للتطبيق
    RewriteRule ^ index.html [L]
</IfModule>

# تخزين مؤقت طويل للأصول (أسماؤها تحمل بصمة، فتتغير مع كل بناء)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css                 "access plus 1 year"
    ExpiresByType application/javascript   "access plus 1 year"
    ExpiresByType image/svg+xml            "access plus 1 year"
    ExpiresByType image/x-icon             "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
    # index.html يجب ألا يُخزَّن حتى تظهر النسخة الجديدة بعد كل رفع
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ضغط النصوص
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
